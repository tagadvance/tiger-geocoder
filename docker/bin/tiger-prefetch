#!/usr/bin/env bash
# Pre-warm the Census download cache for a generated loader script.
#
# Rather than rewrite the generated scripts' fetch logic, run the exact wget
# lines they contain, one at a time, from the same working directory. wget
# --mirror then finds the files already present and skips them on the real pass.
# What this buys is not speed -- it is the checksum verification, the shared
# cache, and the clean stop on a rate limit, none of which the generated script
# does.
#
# www2.census.gov sits behind Cloudflare, which rate-limits. Tripping it returns
# 429 for *every* request with a Retry-After measured in the thousands of
# seconds -- an hour-long block observed in practice. Two consequences shape
# this script:
#
#   Pace requests. One at a time, one second apart. Parallelism was measured
#   to buy nothing here -- the FTP mirror caps per-client bandwidth, so 8
#   workers ran no faster than 4 -- while over HTTPS it is exactly what trips
#   the limiter. A national load is ~13,000 files; sustained flat out, it will
#   trip it.
#
#   Stop immediately on 429, rather than retrying. When the server says come
#   back in an hour, retrying inside the run cannot succeed and only deepens the
#   block. Failing fast is also cheap to recover from: the cache is on disk, so
#   re-running picks up where this left off and re-downloads nothing.
#
# Every other failure is soft. This script is an optimization, not the download:
# the generated loader script does its own serial `wget --mirror` pass, which
# skips whatever is already on disk and fetches whatever is not. So a file this
# script could not get -- an FTP control connection dropped, a reset
# mid-transfer -- costs a repeat fetch in the loader's own pass, not a dead run.
# Propagating it instead is how one transient error out of ~13,000 files used to
# abort an eight-hour load at its first state, taking the rest of the batch and
# the index build with it. A file that is genuinely gone rather than briefly unreachable
# is caught downstream by api.state_is_complete, which is what keeps a partial
# state out of api.load_log.
set -euo pipefail

script=${1:?usage: tiger-prefetch <generated-script>}
staging=${TIGER_STAGING:-/gisdata}

# ftp:// as well as http(s)://. The Census FTP mirror is the default source,
# and a pattern that missed it would silently make this whole script a no-op:
# zero URLs is not an error, so the generated script would quietly fall back to
# fetching everything serially, unverified, with no rate-limit handling.
mapfile -t urls < <(grep --only-matching --extended-regexp \
  '(https?|ftp)://[^[:space:]]+\.zip' "$script" | sort --unique)

if [[ ${#urls[@]} -eq 0 ]]; then
  exit 0
fi

# One request at a time, one second apart, from either mirror. This is a
# one-time import, so there is nothing to gain by tuning it and a rate-limit
# block to lose by getting it wrong. If HTTPS trips the limiter anyway, the
# answer is the FTP mirror, not a smaller number here.
wait_secs=1

# www2.census.gov and ftp2.census.gov serve byte-identical files at identical
# paths, but wget --mirror keys its cache on the hostname. Without this,
# switching protocols -- exactly what a rate-limit stop asks you to do -- would
# re-download everything already on disk, and switching back would do it again.
# Point every host name at one directory so the cache survives the switch.
unify_cache() {
  local canonical=$staging/census-cache host path
  mkdir --parents "$canonical"
  for host in www2.census.gov ftp2.census.gov ftp.census.gov; do
    path=$staging/$host
    [[ -L $path ]] && continue
    if [[ -d $path ]]; then
      # Hard links where possible: same filesystem, no second copy of 30GB.
      cp --archive --link "$path/." "$canonical/" 2>/dev/null \
        || cp --archive "$path/." "$canonical/"
      rm --recursive --force "$path"
    fi
    ln --symbolic --no-target-directory "$canonical" "$path"
  done
}
unify_cache

# Fetching in one process means this is all just shell state -- no sentinel
# files, no exported functions, no coordination between workers.
ratelimit_retry=
softfailed=0

# Record a file this run could not get, and carry on.
soft_fail() {
  printf 'prefetch: %s: %s -- leaving it to the loader'"'"'s own pass\n' "$2" "$1" >&2
  softfailed=$((softfailed + 1))
}

# Zip members carry CRC32s written by the Census, so testing the archive checks
# the transfer against *their* checksums rather than merely against our own
# copy. That catches truncation and corruption; hashing whatever arrived cannot,
# because it would faithfully hash a half-file.
#
# The .sha256 sidecar is written only after that check passes, so its presence
# -- not the zip's -- is what marks a download complete. This matters because
# wget writes straight to the final filename with no staging: an interrupted
# transfer leaves a truncated file that is indistinguishable, by name and
# timestamp, from a finished one.
verify() {
  local path=$1
  if ! unzip -qq -t "$path" >/dev/null 2>&1; then
    printf 'prefetch: corrupt or truncated, discarding %s\n' "$path" >&2
    rm --force "$path" "$path.sha256"
    return 1
  fi
  sha256sum "$path" | cut --delimiter=' ' --fields=1 >"$path.sha256"
}

fetch() {
  local url=$1 out
  local path=${url#*://}

  if [[ ${TIGER_DOWNLOAD_REVALIDATE:-false} != true && -s $path ]]; then
    # Verified already: skip without contacting the server. wget --mirror would
    # otherwise revalidate, and a revalidation is still a request -- resuming a
    # national load would spend ~13,000 of them to download nothing, tripping
    # the rate limit that stopped the first attempt.
    [[ -s $path.sha256 ]] && return 0
    # Present but unverified: the generated script downloads serially and writes
    # no sidecar. Check it locally rather than fetching it again.
    verify "$path" && return 0
  fi

  # --retry-connrefused and a longer ladder than the default because the FTP
  # mirror drops control connections, and three tries over ~20s is not enough to
  # ride out a server-side connection cap.
  if out=$(wget --no-verbose --server-response --mirror --reject=html \
             --tries=5 --waitretry=30 --retry-connrefused --timeout=60 \
             --wait="$wait_secs" --random-wait "$url" 2>&1); then
    verify "$path" || soft_fail "$url" "corrupt after download"
    return 0
  fi

  if grep --quiet --extended-regexp 'HTTP/[0-9.]+ 429' <<<"$out"; then
    ratelimit_retry=$(grep --ignore-case --only-matching --extended-regexp \
      'Retry-After: *[0-9]+' <<<"$out" | grep --only-matching '[0-9]*$' | tail -1)
    return 1
  fi

  soft_fail "$url" "download failed"
  return 0
}

printf 'prefetching %d files (%ss between requests)\n' \
  "${#urls[@]}" "$wait_secs" >&2
cd "$staging"

TIGER_DOWNLOAD_REVALIDATE=${TIGER_DOWNLOAD_REVALIDATE:-false}
for url in "${urls[@]}"; do
  # The only failure fetch reports is a rate limit, and nothing later in the
  # list can succeed once the server is refusing every request.
  fetch "$url" || break
done

if [[ -n $ratelimit_retry ]]; then
  retry=$ratelimit_retry
  printf '\nprefetch: rate limited by the Census server (HTTP 429).\n' >&2
  printf 'Retry-After: %s seconds (~%s minutes).\n' "$retry" "$((retry / 60))" >&2
  printf 'Nothing already downloaded is lost -- re-run after the wait and the\n' >&2
  printf 'cache resumes where this stopped. Use the FTP mirror to avoid it.\n' >&2
  exit 75   # EX_TEMPFAIL: retry later, do not treat as a broken load
fi

if [[ $softfailed -gt 0 ]]; then
  printf '\nprefetch: %d file(s) not fetched; the loader will try them again in\n' \
    "$softfailed" >&2
  printf 'its own pass. A file that is truly missing is caught by verification.\n' >&2
fi

# Deliberately 0 unless rate limited: see the header. A prefetch problem must
# not abort the load, because the serial pass can still succeed and completeness
# is asserted against the data afterwards, not against this exit code.
exit 0
