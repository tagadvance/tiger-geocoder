#!/usr/bin/env bash
# Generate, harden, and run the Census TIGER loader scripts.
#
#   tiger-load nation            national county/state layers (do this first)
#   tiger-load states OH KY      per-state address and street data
#   tiger-load index             install missing indexes, then vacuum analyze
#   tiger-load all OH KY         all three, in order
#   tiger-load verify [OH ...]   completeness report; defaults to every loaded state
#
# States may also come from TIGER_STATES as a comma or space separated list.
set -euo pipefail

: "${PGDATABASE:=geocoder}"
: "${PGUSER:=postgres}"
: "${TIGER_STAGING:=/gisdata}"
: "${TIGER_PLATFORM:=docker}"
export PGDATABASE PGUSER

# A missing loader binary is otherwise invisible: the generated script resolves
# its tools with `command -v` inside an assignment, which under `set -e` aborts
# the whole load with no output at all. Fail here instead, with a name.
preflight() {
  local tool
  for tool in psql shp2pgsql unzip wget; do
    if ! command -v "$tool" >/dev/null; then
      log "required tool not found: ${tool}"
      exit 69
    fi
  done
}

log() { printf '%s  %s\n' "$(date --utc +%FT%TZ)" "$*" >&2; }
query() { psql --no-align --tuples-only --no-psqlrc --set ON_ERROR_STOP=1 "$@"; }

# Upstream tells you to add `set -e -u` to the generated script by hand and
# leaves it there. That is necessary but not sufficient: their loops read
# `for z in *.zip`, so when a state has no file for a layer -- routine, not an
# error -- the glob stays literal and unzip fails, taking the whole load with
# it under -e. nullglob makes the loop body correctly not run at all.
generate() {
  local name=$1 sql=$2
  local script="${TIGER_STAGING}/${name}.sh"
  log "generating ${name}"
  {
    printf '#!/usr/bin/env bash\nset -euo pipefail\nshopt -s nullglob\n'
    query --command "$sql"
  } >"$script"
  chmod +x "$script"
  printf '%s' "$script"
}

run() {
  local script=$1
  tiger-prefetch "$script"
  log "running $(basename "$script")"
  bash "$script"
}

# The generated nation script creates its tables unconditionally, so re-running
# it fails on "relation state_all already exists". That matters because loading
# states incrementally is the normal workflow, and `all` has to stay re-runnable
# for it. Set TIGER_RELOAD_NATION=1 to force it, e.g. for a new TIGER vintage.
load_nation() {
  if [[ ${TIGER_RELOAD_NATION:-0} != 1 ]] \
    && [[ $(query --command "SELECT to_regclass('tiger_data.state_all') IS NOT NULL") == *t* ]]; then
    log "nation data already loaded; skipping (TIGER_RELOAD_NATION=1 to force)"
    return
  fi
  run "$(generate nation "SELECT loader_generate_nation_script('${TIGER_PLATFORM}')")"
}

# The generated state script also creates its tables unconditionally. An
# interrupted load therefore leaves partial tiger_data tables that block every
# retry -- the likeliest way to lose a long load. Dropping this state's tables
# first makes each state load a clean (re)load rather than a one-shot.
drop_state_tables() {
  local upper=$1
  query --command "DO \$\$
    DECLARE t record;
    BEGIN
      FOR t IN SELECT tablename FROM pg_tables
        WHERE schemaname = 'tiger_data' AND tablename LIKE lower('${upper}') || '\\_%'
      LOOP
        EXECUTE format('DROP TABLE IF EXISTS tiger_data.%I CASCADE', t.tablename);
      END LOOP;
    END
  \$\$;"
}

# Exiting 0 is not proof a state loaded completely. nullglob keeps a missing file
# from aborting the run, which necessarily makes it a silent skip instead, and
# county-level layers are fetched one file per county -- so a state can lose a
# dozen counties and still look healthy. Assert completeness against the data
# before recording the state as loaded, so that a failed load stays absent from
# api.load_log and the next run drops and reloads it.
verify_loaded() {
  local upper=$1
  local deep=${TIGER_VERIFY_DEEP:-false}
  if [[ $(query --command "SELECT api.state_is_complete('${upper}', ${deep})") == *t* ]]; then
    log "${upper} verified complete"
    return 0
  fi
  log "${upper} FAILED verification; not recording it as loaded"
  psql --no-psqlrc --command \
    "SELECT layer, check_name, detail FROM api.verify_state('${upper}', ${deep})
     WHERE ok IS FALSE;" >&2
  return 1
}

load_states() {
  local state upper
  for state in "$@"; do
    upper=${state^^}
    if [[ ${TIGER_RELOAD_STATES:-0} != 1 ]] \
      && [[ $(query --command "SELECT count(*) > 0 FROM api.load_log WHERE state = '${upper}'") == *t* ]]; then
      log "${upper} already loaded; skipping (TIGER_RELOAD_STATES=1 to force)"
      continue
    fi
    log "clearing any previous ${upper} tables"
    drop_state_tables "$upper"
    run "$(generate "state_${state,,}" \
      "SELECT loader_generate_script(ARRAY['${upper}'], '${TIGER_PLATFORM}')")"
    if ! verify_loaded "$upper"; then
      log "re-run to retry ${upper}: its tables are dropped and reloaded on retry"
      exit 65
    fi
    query --command "INSERT INTO api.load_log (state, tiger_year)
      SELECT '${upper}', tiger_year FROM tiger.loader_variables
      ON CONFLICT (state) DO UPDATE
        SET tiger_year = EXCLUDED.tiger_year, loaded_at = now();"
    log "loaded ${upper}"
  done
}

# Without this the geocoder technically works and is unusably slow: the loader
# creates tables but not all of the indexes the geocode functions rely on.
build_indexes() {
  log "installing missing indexes"
  query --command 'SELECT install_missing_indexes();'
  # Fed on stdin, not with --command: psql sends a --command string as one
  # simple query, which puts it in an implicit transaction, and VACUUM cannot
  # run inside one. Statements read from stdin each run on their own.
  log "vacuum analyze"
  psql --no-psqlrc --set ON_ERROR_STOP=1 <<-'SQL'
	VACUUM (ANALYZE) tiger.addr;
	VACUUM (ANALYZE) tiger.edges;
	VACUUM (ANALYZE) tiger.faces;
	VACUUM (ANALYZE) tiger.featnames;
	VACUUM (ANALYZE) tiger.place;
	VACUUM (ANALYZE) tiger.cousub;
	VACUUM (ANALYZE) tiger.county;
	VACUUM (ANALYZE) tiger.state;
	VACUUM (ANALYZE) tiger.zip_lookup_base;
	VACUUM (ANALYZE) tiger.zip_state;
	VACUUM (ANALYZE) tiger.zip_state_loc;
	SQL
}

# Standalone completeness report. With no arguments it checks every state the
# load log claims to hold, which is the check to run before trusting a database.
verify_states() {
  local states=("$@")
  local deep=${TIGER_VERIFY_DEEP:-false}
  local failed=0 state
  if [[ ${#states[@]} -eq 0 ]]; then
    mapfile -t states < <(query --command "SELECT state FROM api.load_log ORDER BY state")
  fi
  if [[ ${#states[@]} -eq 0 ]]; then
    log "no states loaded"
    return 0
  fi
  for state in "${states[@]}"; do
    printf '\n== %s ==\n' "${state^^}"
    psql --no-psqlrc --command \
      "SELECT layer, check_name, ok, detail FROM api.verify_state('${state^^}', ${deep});"
    if [[ $(query --command "SELECT api.state_is_complete('${state^^}', ${deep})") != *t* ]]; then
      failed=$((failed + 1))
    fi
  done
  if [[ $failed -gt 0 ]]; then
    log "${failed} state(s) incomplete"
    return 1
  fi
  log "all states complete"
}

require_states() {
  if [[ $# -eq 0 ]]; then
    log "no states given; pass them as arguments or set TIGER_STATES"
    exit 64
  fi
}

command=${1:-all}
shift || true
states=("$@")
if [[ ${#states[@]} -eq 0 && -n ${TIGER_STATES:-} ]]; then
  read -ra states <<<"${TIGER_STATES//,/ }"
fi

preflight

case "$command" in
  nation) load_nation ;;
  states) require_states "${states[@]}"; load_states "${states[@]}" ;;
  index)  build_indexes ;;
  verify) verify_states "${states[@]}" ;;
  all)    require_states "${states[@]}"
          load_nation
          load_states "${states[@]}"
          build_indexes ;;
  *)      log "usage: tiger-load [nation|states|index|all|verify] [STATE...]"; exit 64 ;;
esac

log "done"
