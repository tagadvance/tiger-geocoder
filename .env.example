# Copy to .env and edit. .env is gitignored.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=geocoder
POSTGRES_USER=postgres
POSTGRES_PORT=5432

# States to load, comma separated. Empty means none; `make load` requires it.
# DC is the smallest and is what the test suite uses.
TIGER_STATES=DC

# Pause between Census downloads. Leave unset: tiger-prefetch picks a default
# from the source -- 0.5s for the FTP mirror, 2s over https, where tripping
# Cloudflare's limit blocks the whole IP for up to an hour. Downloads always run
# one at a time; there is no concurrency setting, because concurrency measured
# no faster on the FTP mirror and is exactly what trips the https limiter.
#TIGER_DOWNLOAD_WAIT=0.5

# Download source. Defaults to the FTP mirror, which is slower per connection
# (~1 MB/s vs 22 MB/s) but is not rate-limited, so a long unattended load will
# not stop dead. Set to https://www2.census.gov/geo/tiger/TIGER2025 for a single
# small state where speed matters more than predictability.
#TIGER_WEBSITE_ROOT=ftp://ftp2.census.gov/geo/tiger/TIGER2025

# Server tuning is computed at startup from the memory and cores the container
# can see -- roughly a quarter of memory to shared_buffers, physical cores to
# the worker pools, half that to any single query. `docker compose logs db |
# grep tiger-tune` shows the result.
#
# load  -- bulk ingest. Faster, and a crash means re-running the load, which is
#          re-runnable by design. The right choice while loading.
# serve -- read-mostly geocoding, durable settings only. Switch once loaded.
TIGER_TUNE_PROFILE=load

# Set false to skip tuning entirely and run on PostgreSQL's stock defaults.
TIGER_TUNE=true
